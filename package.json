{
  "name": "words",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "A self-hosted real-time letter-grid party game.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors blue,green \"npm run dev --workspace @words/server\" \"npm run dev --workspace @words/client\"",
    "data:verify": "node packages/game-data/scripts/verify-data.mjs",
    "data:dictionary:build": "node packages/game-data/scripts/build-dictionary.mjs",
    "data:dictionary:audit": "node packages/game-data/scripts/audit-vocabulary.mjs",
    "data:distribution:derive": "node packages/game-data/scripts/derive-distribution.mjs",
    "data:boards:audit": "tsx packages/game-data/scripts/audit-boards.mjs",
    "research:boards": "tsx scripts/research-board-quality.ts",
    "research:median-selection": "tsx scripts/audit-median-board-selection.ts",
    "research:strong-selection": "tsx scripts/audit-strong-board-selection.ts",
    "privacy:check": "node scripts/check-public-privacy.mjs",
    "build:production": "npm run build --workspace @words/client && node scripts/build-production.mjs",
    "start:production": "node dist/production/server/index.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:container": "node scripts/smoke-container.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
